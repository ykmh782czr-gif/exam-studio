{
  "name": "exam-studio-preview",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./assets.generated",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "ATTEMPTS", "class_name": "ExamAttempts" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ExamAttempts"] }]
}
